'''
RHS of both primal and dual systems
'''

# Construimos la matriz de acoplamiento
A = (a / h ** 2) * gen_laplacian(Nx - 1)

# Construimos el operador de control
B = control_op(x[:Nx - 1], omega)

def f(x, t, u):
    return np.dot(A, x) + np.dot(B, u)

def phi(x, t):
    return np.dot(-A.T, x)

'''
Exact Solution of Uncontrolled Heat Equation
'''

def y_e(x, t):
    return 10 * np.exp(-t * np.pi ** 2 * a) * np.sin(np.pi * x)

sol_exact = np.array([y_e(x, t0) for t0 in t])

