import numpy as np
import scipy.sparse as sp
from scipy.integrate import odeint
import matplotlib.pyplot as plt
from scipy.optimize import fsolve
'''
Control and Laplace operators discretizations
'''
def gen_laplacian(num):
    data1 = [-2] * num
    data1[0] = -2
    data1[-1] = -2
    data2 = [1] * num
    data3 = [1] * num
    L = sp.spdiags([data2, data1, data3], [-1, 0, 1], num, num)
    return L.toarray()

def control_op(x, omega):
    a = omega[0]
    b = omega[1]
    return np.diag([1 if a <= x0 <= b else 0 for x0 in x])

'''
Discretization of the L^2(0,1) norm and its inner product
'''
def norma(x,h):
    n = x.shape[0]

    suma = 0
    for i in range(n):
        suma += x[i] ** 2
    return np.sqrt(h * suma)


def pi_l2(x, y, h):
    n = x.shape[0]

    suma = 0
    for i in range(n):
        suma += x[i] * y[i]
    return h * suma

