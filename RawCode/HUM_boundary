'''
HUM Method
'''

def HUM (t,f00,solver,tau,h):

    #----First Iteration------
    sol_u = odeint(phi, f00, t)
    y = solver(x0, t, f, sol_u,tau)

    y_bc=[np.concatenate([[0],y[i],[0]]) for i in range(len(t))]

    print(10*'--','First HUM iteration',10*'--')
    print('Approximation error uncontrolled system', np.linalg.norm(y_bc - sol_exact) )
    print('\n')
    print('First iteration y(T)', y[-1])

    # Initial values
    g0 = y[-1] #gradient
    g00 = g0
    w0 = g0
    f0 = f00

    print('Error ||g0||', norma(g0, h))

    for ite in range(n_iter):
        #------Computation of Aw^n------

        # Adjoint
        sol_adj = odeint(phi, w0, t)

        # Primal
        y = solver(np.zeros(len(x0)), t, f, sol_adj,tau)  # with 0 initial value

        g_bar = y[-1] #--- Aw^n

        #---step size---- ||gn||^2/ a(w^n, w^n)
        rho = norma(g0, h) ** 2 / pi_l2(g_bar, w0, h)

        #new iteration final datum
        f_new= f0 - rho * w0

        # Residual
        g_new = g0 - rho * g_bar #g_n -rho_n Aw^n

        # ____Stopping criteria____
        paro = norma(g_new, h)/norma(g00,h)

        #------------------------------------------
        print(10*'--',ite, '||g0||', paro, 10*'--', '\n')
        #-----------------------------------------

        if (paro <= tol):
            # f^{n+1} =f

            #---------Solve the control problem with approximation value------
            #Adjoint
            sol_adj = odeint(phi, f_new, t)
            #Primal
            y = solver(x0, t, f, sol_adj,tau)  # With y0 initial condition
            #
            print('Convergence at %i iterations: y(T):' % ite, y[-1])
            break

        # ----New conjugated direction----
        else:
            # Step size of new direction
            gamma = norma(g_new, h) ** 2 / norma(g0, h) ** 2

            # New direction
            w = g_new + gamma * w0

            # ---Update---
            w0 = w
            g0 = g_new
            f0 = f_new
    return f_new, sol_adj, y

'''
Discretization of both dual and primal functionals
'''
def J(varphi, varphi_T, y0, h, tau):
    '''
    varphi y varphi_T: es la solución del adjunto y su dato final
    y0: dato inicial del sistema primal
    h: tamaño de paso en el espacio
    tau: tamaño de paso en el tiempo
    '''

    # primer sumando
    suma = 0
    for i in range(Nt):
        for j in range(Nx - 1):
            suma += varphi[i, j] ** 2
    suma = 0.5 * h * tau * suma

    # Segundo sumando
    suma2 = 0
    for i in range(Nx - 1):
        suma2 += y0[i] * varphi[0, i]
    suma2 = h * suma2

    return suma + suma2

def F_primal(u,h):
    '''
    u: control
    h: space step size
    '''
    u_ = []

    # Discretization of the L^2((0,T)\times (0,1)) norm
    suma = 0
    for i in range(Nt):  # time
        for j in range(Nx - 1):  # space
            suma += (u[i, j])** 2
    return 0.5 * h * tau * suma

'''
----------------Output
'''

norma_final=[]
opt_condition=[]
for solver in [odeEuler,BackwardEuler,rungekutta4]:
    f_new, sol_adj, y = HUM(t,f0,solver, tau, h)
    control = np.array([B.dot(sol_adj[i]) for i in range(len(t))])
    norma_final.append(norma(y[-1],h))
    opt_condition.append(abs(F_primal(control,h) + J(sol_adj, f_new, x0,h,tau)))

print('\n')
print((a * tau / h ** 2) < 0.5)
print('||y(T)||',norma_final,'\n J(control)=-F(phi)', opt_condition)


