# Runge Kutta
def rungekutta4(y0,t,f,u,tau):
    n = len(t)
    y = np.zeros((n, len(y0)))  # Vector vacío de aproximacioń
    y[0] = y0  # condición inicial
    # Scheme
    for i in range(n - 1):
        # --------------------
        k1 = f(y[i], t[i], (B.T).dot(u[i]))
        k2 = f(y[i] + 0.5 * k1 * tau, t[i] + 0.5 * tau, (B.T).dot(u[i]))
        k3 = f(y[i] + 0.5 * k2 * tau, t[i] + 0.5 * tau, (B.T).dot(u[i]))
        k4 = f(y[i] + k3 * tau, t[i] + h, (B.T).dot(u[i]))
        # -------------------
        y[i + 1] = y[i] + (tau / 6.0) * (k1 + 2 * k2 + 2 * k3 + k4)
    return y
# Explicit Euler
def odeEuler(y0,t,f,u,tau):
    #step_size=.0025
    y_arr=np.zeros((len(t),len(y0)))
    y_arr[0]=y0
    for n in range(len(t)-1):
        y_arr[n+1] = y_arr[n] + ( f(y_arr[n],t, (B.T).dot(u[n]) ) )*tau #
    return y_arr
# Implicit Euler
def residual(yp,yo,f,u,tau):
    # y0 and f are the parameters
    return yp - yo - tau * f(yp,0,u)
def BackwardEuler(y0, t, f, u, tau):
    n = len(t)
    y = np.zeros([len(t), len(y0)])
    y[0] = y0
    for i in range(0, n - 1):
        # Root Finding solution
        yp=fsolve (residual, y[i] + tau*f(y[i],t[i],(B.T).dot(u[i])), args = (y[i],f,(B.T).dot(u[i]),tau))
        y[i + 1] = yp
    return y

